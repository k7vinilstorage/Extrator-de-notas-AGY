# Copie para .env e ajuste.

# Obrigatório: token exigido em "Authorization: Bearer <token>".
# Gere um com: openssl rand -hex 32
EXTRATOR_API_TOKEN=

# Porta exposta no host
EXTRATOR_PORTA=8000

# Modelo do agy (veja os disponíveis com: docker compose run --rm extrator agy models)
EXTRATOR_MODELO=Gemini 3.8 Flash (Low)

# Quantas chamadas ao agy rodam ao mesmo tempo (vale para /extrair e /lotes juntos).
# Cada agy usa ~200 MB de RAM.
EXTRATOR_PARALELO=4

# Segundos por chamada ao agy
EXTRATOR_TIMEOUT=90

# Reler notas que falharem na validação (1 = sim, 0 = não, mais rápido)
EXTRATOR_REVISAR=1

# Limites de upload
EXTRATOR_MAX_MB=20
EXTRATOR_MAX_ARQUIVOS_LOTE=100

# Minutos que um lote concluído fica disponível para consulta
EXTRATOR_LOTE_TTL_MIN=60

# Apagar o histórico de conversas que o agy grava (~1 MB por nota)
EXTRATOR_LIMPAR_HISTORICO=1

# Fuso horário do container (datas de criação dos lotes)
TZ=America/Sao_Paulo
